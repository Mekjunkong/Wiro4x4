{
  "name": "WIRO 4x4 Booking Prep Monitor",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 * * * *"
            }
          ]
        }
      },
      "id": "hourly",
      "name": "Every Hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "url": "={{ $env.WIRO_SITE_URL }}/api/n8n/operations-snapshot",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Wiro-Automation-Secret",
              "value": "={{ $env.WIRO_N8N_API_SECRET }}"
            }
          ]
        },
        "options": {}
      },
      "id": "fetch-snapshot",
      "name": "Fetch Wiro Snapshot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 0]
    },
    {
      "parameters": {
        "jsCode": "const bookings = $json.queues?.bookingRemindersDue ?? [];\nif (bookings.length === 0) return [];\nconst ids = bookings.map((booking) => booking.id).sort((a, b) => a - b).join(\"-\");\nconst rows = bookings.slice(0, 10).map((booking) => `#${booking.id} ${booking.contactName} ${booking.contactPhone ?? \"no phone\"} arrival ${booking.arrivalDate ?? \"TBD\"} (${booking.status})`).join(\"\\n\");\nreturn [{\n  json: {\n    action: \"ops.notify\",\n    title: `${bookings.length} WIRO booking${bookings.length === 1 ? \"\" : \"s\"} need pre-tour prep`,\n    content: `These bookings are approaching and still need reminder/prep attention:\\n\\n${rows}\\n\\nConfirm vehicle, guide, pickup point, kosher/Shabbat needs, and guest WhatsApp readiness.`,\n    priority: \"warning\",\n    resourceType: \"booking\",\n    dedupeKey: `booking-prep:${ids}`,\n    cooldownMinutes: 180\n  }\n}];"
      },
      "id": "build-prep-alert",
      "name": "Build Prep Alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [520, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.WIRO_SITE_URL }}/api/n8n/actions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Wiro-Automation-Secret",
              "value": "={{ $env.WIRO_N8N_API_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json }}",
        "options": {}
      },
      "id": "notify-owner",
      "name": "Notify Owner",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [780, 0]
    },
    {
      "parameters": {
        "content": "This workflow runs hourly and alerts the owner when confirmed tours are approaching and pre-tour reminder/prep work is due.\n\nRequired n8n environment variables:\nWIRO_SITE_URL=https://www.wiro4x4indochina.com\nWIRO_N8N_API_SECRET=<same value as Wiro N8N_API_SECRET>\n\nWiro needs OWNER_EMAIL plus RESEND_API_KEY, or TELEGRAM_BOT_TOKEN plus TELEGRAM_CHAT_ID, for ops.notify delivery.",
        "height": 320,
        "width": 420
      },
      "id": "setup-notes",
      "name": "Setup Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [0, 240]
    }
  ],
  "connections": {
    "Every Hour": {
      "main": [
        [
          {
            "node": "Fetch Wiro Snapshot",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Wiro Snapshot": {
      "main": [
        [
          {
            "node": "Build Prep Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Prep Alert": {
      "main": [
        [
          {
            "node": "Notify Owner",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "timezone": "Asia/Bangkok",
    "executionOrder": "v1"
  },
  "pinData": {},
  "versionId": "wiro-n8n-booking-prep-monitor-v1",
  "triggerCount": 1,
  "tags": []
}
