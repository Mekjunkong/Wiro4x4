# Database (PlanetScale)
DATABASE_URL=mysql://user:pass@aws.connect.psdb.cloud/wiro?ssl={"rejectUnauthorized":true}

# Authentication
JWT_SECRET=generate-with-openssl-rand-base64-32

# Storage (Cloudflare R2)
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=wiro-storage
R2_PUBLIC_URL=https://pub-xxxxxxxxx.r2.dev

# Notifications
OWNER_EMAIL=wiro.adventures@gmail.com

# Customer Chatbot
# Customer replies come only from the isolated Levi profile on the VPS.
LEVI_CHAT_URL=https://levi-wiro.srv1691893.hstgr.cloud/v1/chat/completions
LEVI_API_KEY=generate-a-separate-64-character-secret

# Optional admin/content AI features. These are not used by Levi customer chat.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxx
OPENAI_API_KEY=sk-proj-xxxxxxxxx

# Signed customer-message alert path: WIRO event → Levi on VPS.
LEVI_WEBHOOK_URL=https://levi-wiro.srv1691893.hstgr.cloud/webhooks/wiro-leads
LEVI_WEBHOOK_SECRET=generate-with-openssl-rand-hex-32

# Optional owner notifications used by other server features. Levi chat does
# not fall back to this Telegram bot.
TELEGRAM_BOT_TOKEN=xxxxxxxxx
TELEGRAM_CHAT_ID=xxxxxxxxx

# Email (Resend) — optional, lazy init
RESEND_API_KEY=re_xxxxxxxxx

# n8n automation — optional.
# When N8N_WEBHOOK_URL is set, Wiro posts lead, booking, review, and WhatsApp
# lifecycle events to this webhook. Leave empty to disable.
# Run npm run n8n:secrets to generate matching Wiro and n8n values.
N8N_AUTOMATION_ENABLED=true
N8N_WEBHOOK_URL=https://n8n.example.com/webhook/wiro-automation
N8N_WEBHOOK_SECRET=generate-with-openssl-rand-base64-32
N8N_API_SECRET=use-the-same-value-as-n8n-webhook-secret
N8N_WEBHOOK_TIMEOUT_MS=5000

# Optional: lets npm run n8n:import and npm run n8n:verify-live use n8n's
# public API. The base URL should end with /api/v1.
N8N_IMPORT_API_BASE_URL=https://n8n.example.com/api/v1
N8N_IMPORT_API_KEY=create-in-n8n-settings-api

# Payments (Stripe) — deferred
STRIPE_SECRET_KEY=sk_live_xxxxxxxxx
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxx

# App Configuration
NODE_ENV=production
VITE_APP_TITLE=Wiro 4x4 - Kosher Off-Road Tours Chiang Mai
VITE_APP_LOGO=https://www.wiro4x4indochina.com/logo.png
SITE_URL=https://www.wiro4x4indochina.com

# Google Search Console URL-prefix verification token only.
# Prefer DNS verification for the domain property when possible.
GOOGLE_SITE_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
